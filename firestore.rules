rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Config ─────────────────────────────────────────────────────
    // General config docs: any authenticated user can read, superadmin can write.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin";
    }

    // Exchange rate cache (config/exchangeRates): any authenticated user
    // can read and write, since rate caching is triggered by normal users
    // during expense/settlement creation with non-base currencies.
    match /config/exchangeRates {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── Users ───────────────────────────────────────────────────────
    // Any authenticated user can read user profiles (needed for member
    // display names, photos, activity attribution, settlement names).
    // A user can create/delete their own document.
    // Self-update allowed but CANNOT change role or blocked (prevent privilege escalation).
    // Superadmins can update any field (block/unblock/promote/demote).
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        // Self-update: cannot change role or blocked fields
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'blocked']))
        // Superadmin can update any field
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin"
      );
      allow delete: if request.auth != null && request.auth.uid == uid;

      // ─── Notifications (subcollection) ───────────────────────────
      // Only the owner can read their notifications.
      // Any authenticated user can create a notification for another user
      // (e.g. invitations, settlement alerts) but only the owner can update
      // (mark as read).
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ─── Collection Group: members ────────────────────────────────
    // Top-level rule for collectionGroup("members") queries used by
    // getUserGroups(). Firestore needs a wildcard path rule to verify
    // that the query is safe across all possible parent paths.
    match /{path=**}/members/{memberUid} {
      allow read: if request.auth != null;
    }

    // ─── Usernames ──────────────────────────────────────────────────
    // Any authenticated user can check if a username is available.
    // Any authenticated user can create/delete their own username entries.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update: if false; // usernames are immutable - delete & recreate
    }

    // ─── Groups ─────────────────────────────────────────────────────
    // Any authenticated user can read group docs (needed for invite code
    // lookup during join flow). Active members can update any group field.
    // Non-members can only update memberCount, totalExpenses, updatedAt
    // (for batch writes during join/accept/decline flows where membership
    // is being established in the same batch).
    // Group admin can delete the group.
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active"
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'totalExpenses', 'updatedAt'])
      );
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == "admin";

      // ─── Members (subcollection) ────────────────────────────────
      // Users can read their own member doc (for join/accept flow membership
      // checks). Active members can read any member doc (for member lists,
      // balances, etc.).
      // Self-join (create with own UID) or active member adding offline member.
      // Self-update: cannot change role or balance (prevent privilege escalation).
      // Active member update: can only change balance (for recalculation batch writes).
      // Self-delete for leaving; admin delete for cleanup; active member delete offline docs.
      match /members/{uid} {
        allow read: if request.auth != null && (
          request.auth.uid == uid
          || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active"
        );
        allow create: if request.auth != null
          && (
            request.auth.uid == uid
            || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active"
          );
        allow update: if request.auth != null && (
          // Self-update: cannot change role or balance
          (request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'balance']))
          // Active member: can only update balance (recalculation)
          || (get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']))
          // Admin: can update role (for admin transfer)
          || (get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == "admin"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']))
        );
        allow delete: if request.auth != null && (
          request.auth.uid == uid
          || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == "admin"
          || (resource.data.isOffline == true
            && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active")
        );
      }

      // ─── Expenses (subcollection) ───────────────────────────────
      // Only active group members can read/create/update/delete expenses.
      match /expenses/{expenseId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active";
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active";
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active";
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active";
      }

      // ─── Settlements (subcollection) ────────────────────────────
      // Only active group members can read/create/update settlements.
      // Admin can delete (for group deletion).
      match /settlements/{settlementId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active";
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active";
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active";
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == "admin";
      }

      // ─── Trip (subcollection) ─────────────────────────────────────
      // Only active group members can read/write trip data.
      match /trip/{docId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active";
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active";
      }

      // ─── Activities (subcollection) ─────────────────────────────
      // Only active group members can read activities.
      // Activities are immutable. Active members can read.
      // Create: must be auth'd AND (active member OR group creator).
      // The creator OR condition handles group creation/join batches where
      // membership is established in the same batch as the activity.
      // Admin can delete (for group deletion).
      match /activities/{activityId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active";
        allow create: if request.auth != null
          && (
            get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active"
            || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
          );
        allow update: if false; // activities are immutable
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == "admin";
      }
    }

    // ─── Invitations ────────────────────────────────────────────────
    // Only the invited user or the inviter can read an invitation.
    // Any authenticated user can create an invitation (when inviting
    // someone to a group). Only the invited user can update the status
    // (accept/decline).
    match /invitations/{invitationId} {
      allow read: if request.auth != null
        && (resource.data.toUid == request.auth.uid
            || resource.data.invitedByUid == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }

    // ─── Broadcasts ─────────────────────────────────────────────────
    // Any authenticated user can read broadcasts (targeting is filtered
    // client-side). Only superadmins can create or update (stop) broadcasts.
    match /broadcasts/{broadcastId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin";
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin";

      // ─── Reads (subcollection) ──────────────────────────────────
      // Users can read their own read/acknowledgment records.
      // Superadmins can read all reads (for read count queries).
      // Users can create/update their own read records (acknowledge).
      match /reads/{uid} {
        allow read: if request.auth != null && (
          request.auth.uid == uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin"
        );
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if false;
      }
    }

    // ─── Support Tickets ───────────────────────────────────────────
    // Users can read only their own tickets. Superadmins can read all.
    // Users create tickets only for themselves (userId == auth.uid).
    // Users can update their own tickets (e.g. reopen). Superadmins
    // can update any ticket (status changes, priority, etc.).
    // Tickets are never deleted (audit trail for money-related issues).
    match /supportTickets/{ticketId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin"
      );
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        // User can update own ticket (e.g. mark read, reopen by replying)
        // but cannot change priority (admin-only field)
        (resource.data.userId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['priority']))
        // Superadmin can update any field
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin"
      );
      allow delete: if false;

      // ─── Messages (subcollection) ──────────────────────────────
      // Ticket owner or superadmin can read messages.
      // Either can create a message (user reply or admin response).
      // Messages are immutable (audit trail).
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin"
        );
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin"
        );
        allow update: if false;
        allow delete: if false;
      }
    }

    // ─── Help Articles (FAQ) ───────────────────────────────────────
    // Top-level helpArticles collection. Any authenticated user can read
    // active articles. Only superadmins can create/update/delete articles.
    match /helpArticles/{articleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin";
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin";
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin";
    }
  }
}